# ==============================================================================
# Project SENTINEL — Master Polyglot Environment Configuration Template
# Domain: Tier-1 RBI-Regulated Digital Payment Aggregator (UPI/Cards/Net-Banking)
# Data Governance: DPDP Act 2023 & PCI-DSS v4.0 Zero-PII Compliance
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` in the root or in respective subproject directories.
# 2. Populate credentials for live cloud/database services or leave
#    SENTINEL_OFFLINE_MOCK=true to run the deterministic offline verification suites.
# 3. NEVER commit `.env` or real credentials to version control.
# ==============================================================================

# --- Global Operational Mode ---
SENTINEL_OFFLINE_MOCK=true
SENTINEL_DATA_DIR=./sentinel_data

# --- Tier 1: Relational & Point-in-Time Feature Store (PostgreSQL / Supabase) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://readonly_user:sanitized_password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=sb_publishable_<placeholder_key>

# --- Tier 2: High-Throughput NoSQL Telemetry Store (MongoDB 7.0 / DocumentDB) ---
# Local Docker or MongoDB Atlas SRV URI
MONGODB_URI=mongodb://localhost:27017/sentinel_fraud_db
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sentinel_fraud_db?retryWrites=true&w=majority
MONGODB_DATABASE=sentinel_fraud_db

# --- Tier 3: Property Graph Engine for Mule Ring Detection (Neo4j 5.x / AuraDB) ---
# Local Docker: bolt://localhost:7687 | AuraDB: neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-neo4j-password>
NEO4J_DATABASE=neo4j

# --- Tier 4: Dense Vector Retrieval Engine (Qdrant 1.11+ / Qdrant Cloud) ---
# Local Docker: http://localhost:6333 (REST), localhost:6334 (gRPC)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=<your-qdrant-cloud-api-key>

# --- Embedding & LLM API Gateways (3072-d Dense Vectors & Investigator RAG) ---
# Tier 1: Euron EURI Gateway
EURI_BASE_URL=https://api.euron.one/api/v1/euri
EURI_API_KEY=<your-euri-api-key>

# Tier 2: Google Gemini API (gemini-embedding-2 & gemini-2.5-flash)
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
GEMINI_LLM_MODEL=gemini-2.5-flash

# --- FastAPI Investigator Assistant Configuration ---
PORT=8000
HOST=0.0.0.0
WORKERS=2

