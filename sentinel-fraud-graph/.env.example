# ============================================================================
# Project SENTINEL — Neo4j Graph Fraud Ring & Shared-Device Detection Engine
# Copy this file to `.env` and populate credentials before running against
# a live Docker container or Neo4j AuraDB instance.
# ============================================================================

# --- Option A: Local Docker Neo4j (Default via docker-compose.yml) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-neo4j-password>
NEO4J_DATABASE=neo4j

# --- Option B: Neo4j AuraDB Cloud (Uncomment to override local Bolt) ---
# NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<your-auradb-generated-password>
# NEO4J_DATABASE=neo4j

# --- Driver Connection Pool & Timeout Resilience ---
NEO4J_MAX_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT_SEC=5.0
NEO4J_ACQUISITION_TIMEOUT_SEC=10.0
NEO4J_BATCH_SIZE=1000

# --- Telemetry Loader Configuration (3-Tier Resolution) ---
# Tier 1: Local sanitized CSV/Parquet directory
SENTINEL_DATA_DIR=./sentinel_data

# Tier 2: Optional PostgreSQL / Supabase Feature Store Replica
# DATABASE_URL=postgresql://readonly_user:<password>@<host>:5432/sentinel

# Tier 3: Deterministic Synthetic Telemetry Generator (Active when Tier 1/2 absent)
SENTINEL_NUM_CUSTOMERS=500
SENTINEL_NUM_MERCHANTS=120
SENTINEL_NUM_DEVICES=900
SENTINEL_NUM_TRANSACTIONS=5500
SENTINEL_SYNTHETIC_SEED=42
