# ============================================================================
# Project SENTINEL — High-Throughput NoSQL Fraud Telemetry & BSON Engine
# Environment Configuration Template (DPDP Act 2023 & PCI-DSS v4.0 Compliant)
# Copy this file to `.env` and populate with your credentials.
# NEVER commit `.env` or real database credentials to version control.
# ============================================================================

# --- 1. MongoDB Connection Configuration ---
# Local Docker / Community Server OR MongoDB Atlas SRV URI:
# Example Atlas URI: mongodb+srv://<username>:<password>@sentinel-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=sentinel_fraud_db

# Connection Pool & SLA Timeout Guardrails (p99 <= 250ms target)
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=10000

# --- 2. Three-Way Telemetry Loader Configuration ---
# Tier 1: Local Sanitized Telemetry Directory (CSV or Parquet)
SENTINEL_DATA_DIR=./sentinel_data

# Tier 2: PostgreSQL / Supabase Feature Store Replica (Optional)
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/sentinel_db
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_KEY=<your_supabase_anon_or_service_role_key>

# Tier 3: Deterministic Synthetic Telemetry Generator Parameters
SENTINEL_NUM_CUSTOMERS=500
SENTINEL_NUM_MERCHANTS=120
SENTINEL_NUM_DEVICES=900
SENTINEL_NUM_TRANSACTIONS=5500
SENTINEL_SYNTHETIC_SEED=42
