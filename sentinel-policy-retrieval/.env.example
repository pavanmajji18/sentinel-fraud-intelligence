# ==============================================================================
# Project SENTINEL — Dense Policy Retrieval Engine (Gemini Embedding 2 & Qdrant)
# Copy this file to `.env` and populate with your credentials.
# NEVER commit `.env` to version control (enforced by hardened .gitignore).
# ==============================================================================

# --- 1. Qdrant Vector Database Configuration ---
# Option A: Qdrant Cloud Managed Cluster (Recommended for Production)
QDRANT_URL=https://<your-cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=<your-qdrant-cloud-api-key>

# Option B: Local Docker Qdrant Instance (via `docker compose up -d`)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

QDRANT_COLLECTION_NAME=sentinel_policy_corpus

# --- 2. Dual-Gateway 3072-d Gemini Embedding 2 Configuration ---
# Gateway 1 (Primary): Euron EURI OpenAI-Compatible Embedding Gateway
EURI_API_KEY=<your-euri-api-key>
EURI_BASE_URL=https://api.euron.one/api/v1/euri
EURI_EMBEDDING_MODEL=gemini-embedding-2

# Gateway 2 (Fallback): Official Google Gemini API (`google-genai` SDK / REST)
GEMINI_API_KEY=<your-google-gemini-api-key>
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

# Embedding Vector Dimensionality (Locked at 3072 for Gemini Embedding 2)
EMBEDDING_DIMENSION=3072

# --- 3. Sliding-Window Chunking Hyperparameters ---
SENTINEL_CHUNK_SIZE_WORDS=180
SENTINEL_CHUNK_OVERLAP_WORDS=40

# --- 4. Three-Tier Telemetry & Corpus Loader Configuration ---
SENTINEL_DATA_DIR=./sentinel_data
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/sentinel_db
SENTINEL_SYNTHETIC_SEED=42
