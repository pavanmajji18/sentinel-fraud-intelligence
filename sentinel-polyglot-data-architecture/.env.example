# Project SENTINEL — Polyglot Data Architecture Environment Template
# Copy to .env for local execution; never commit real credentials.
SENTINEL_DATA_DIR=./sentinel_data
DATABASE_URL=postgresql://sentinel_readonly:<password>@localhost:5432/sentinel_db
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<sanitized-anon-or-service-key>
SENTINEL_NUM_CUSTOMERS=500
SENTINEL_NUM_MERCHANTS=120
SENTINEL_NUM_DEVICES=900
SENTINEL_NUM_TRANSACTIONS=5500
SENTINEL_SYNTHETIC_SEED=42
