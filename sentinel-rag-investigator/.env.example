# ============================================================================
# Project SENTINEL — Polyglot FastAPI RAG Investigator Assistant (.env.example)
# ============================================================================

# --- 1. Telemetry & Relational Feature Store (Tier 1 / Tier 2 / Tier 3) ---
SENTINEL_DATA_DIR=./sentinel_data
DATABASE_URL=postgresql://sentinel_ro:<REDACTED_PASSWORD>@db.sentinel-internal.example.com:5432/sentinel_prod
SUPABASE_URL=https://<REDACTED_PROJECT_ID>.supabase.co
SUPABASE_KEY=<REDACTED_SUPABASE_SERVICE_ROLE_KEY>

# --- 2. Document Telemetry Store (MongoDB Replica Set) ---
MONGODB_URI=mongodb+srv://sentinel_app:<REDACTED_PASSWORD>@sentinel-cluster.mongodb.net/sentinel_fraud_db?retryWrites=true&w=majority

# --- 3. Graph Fraud Ring Engine (Neo4j Bolt / AuraDB) ---
NEO4J_URI=neo4j+s://<REDACTED_INSTANCE_ID>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<REDACTED_NEO4J_PASSWORD>

# --- 4. Dense Vector Policy Store (Qdrant Cloud / Local) ---
QDRANT_URL=https://<REDACTED_CLUSTER_ID>.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=<REDACTED_QDRANT_API_KEY>
QDRANT_COLLECTION=sentinel_policy_corpus

# --- 5. Dual-Gateway Embedding (3072-d) & LLM Synthesis ---
# Primary: Euron EURI OpenAI-Compatible Gateway
EURI_API_KEY=<REDACTED_EURI_API_KEY>
EURI_BASE_URL=https://api.euron.one/api/v1/euri
EURI_EMBEDDING_MODEL=gemini-embedding-2
EURI_CHAT_MODEL=gemini-2.5-flash

# Secondary: Direct Google Gemini API
GEMINI_API_KEY=<REDACTED_GEMINI_API_KEY>
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
GEMINI_CHAT_MODEL=gemini-2.5-flash

# --- 6. Service & SLA Thresholds ---
SENTINEL_SLA_TIMEOUT_MS=250
SENTINEL_FAIL_OPEN_INR_LIMIT=10000.0
SENTINEL_SYNTHETIC_SEED=42
