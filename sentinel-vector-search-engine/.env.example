# Project SENTINEL — Vector Search & HNSW Engine Environment Configuration
# Copy this file to `.env` for live cloud connectivity. Never commit `.env` to Git.

# 1. Dual-Gateway Embedding Configuration (3072-d Gemini Embedding 2)
EURI_API_KEY=your_euri_api_key_here
EURI_BASE_URL=https://api.euron.one/api/v1/euri
GEMINI_API_KEY=your_gemini_api_key_here
SENTINEL_EMBEDDING_MODEL=gemini-embedding-2-preview
SENTINEL_EMBEDDING_DIM=3072

# 2. Qdrant Cloud / Local Vector Database Configuration
QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# 3. Telemetry Loader Configuration (3-Tier Automatic Fallback)
SENTINEL_DATA_DIR=./sentinel_data
DATABASE_URL=postgresql://readonly_user:password@db.example.supabase.co:5432/postgres
SENTINEL_NUM_TRANSACTIONS=5500
SENTINEL_SYNTHETIC_SEED=42
