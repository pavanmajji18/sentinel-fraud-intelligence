# ============================================================================
# Project SENTINEL — Point-in-Time Feature Engineering & Leakage-Free Pipeline
# Sanitized Environment Configuration Template (Zero Secrets Committed)
# ============================================================================

# Tier 1: Local Sanitized Telemetry Directory (CSV or Parquet)
SENTINEL_DATA_DIR=./sentinel_data

# Tier 2: PostgreSQL / Supabase Feature Store Replica (Optional)
DATABASE_URL=postgresql://readonly_user:<REDACTED_PASSWORD>@db.sentinel-internal.example.com:5432/sentinel_prod

# Tier 3: Deterministic Synthetic Telemetry Generator Parameters
SENTINEL_NUM_CUSTOMERS=500
SENTINEL_NUM_MERCHANTS=120
SENTINEL_NUM_DEVICES=900
SENTINEL_NUM_TRANSACTIONS=5500
SENTINEL_SYNTHETIC_SEED=42

# Timezone & Compliance Configuration
SENTINEL_TIMEZONE=Asia/Kolkata
SENTINEL_ENFORCE_DPDP_GUARDRAILS=true
